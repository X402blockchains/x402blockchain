# Server-only, configured in Sites. Never put secrets in frontend code.
ADMIN_EMAILS=
# Per-source HMAC secrets, supplied by an operator after agreeing a receipt feed.
INGEST_KEYS_JSON={}
# Optional dedicated BSC HTTPS RPC (chain 56, eth_getLogs + finalized-block support).
BSC_RPC_URL=
# Historical starting block. Omit to begin ~2,000 finalized blocks before first run.
BSC_START_BLOCK=
# Optional mainnet providers for read-only transaction lookup; never exposed to clients.
BASE_RPC_URL=
SOLANA_RPC_URL=
XRPL_RPC_URL=
# Optional Base USDC authorization indexer historical starting block.
BASE_START_BLOCK=
# Self-hosted collector settings. No private keys required.
XRPL_START_LEDGER=
BASE_BATCH_BLOCKS=5
INDEXER_BUDGET_MS=12000
INDEXER_INTERVAL_MS=5000
INDEXER_DB=.local/indexer.sqlite
PORT=4174
LISTEN_HOST=127.0.0.1

# Optional independently hosted read API base URL, e.g. https://your-domain/data
COLLECTOR_API_URL=
# Set /data when the collector is mounted on that subpath.
API_BASE_PATH=

# Optional archived Base start for the separate historical reader.
BASE_HISTORY_START_BLOCK=
